{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dewz",
  "version": "0.2.0",
  "identifier": "app.dewz.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dewz",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; img-src data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 binoema",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
